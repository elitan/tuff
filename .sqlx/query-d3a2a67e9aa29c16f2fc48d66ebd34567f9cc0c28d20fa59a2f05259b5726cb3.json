  "query": "SELECT p.train, p.lat, p.lon, p.bearing, p.speed, p.ts, p.path, p.ahead, p.received_at\n           FROM positions p JOIN trains t ON t.number = p.train\n           WHERE p.ts > $1 AND p.received_at > $2\n           ORDER BY p.ts",
